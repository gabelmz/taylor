// SHEET STYLING
function styleSheet(sheet, numCols) {
  sheet.getRange(1, 1, 1, numCols)
    .setBackground('#1a73e8').setFontColor('#ffffff').setFontWeight('bold').setFontSize(10);
  sheet.setFrozenRows(1);
  const lastRow = sheet.getLastRow();
  if (lastRow > 1) sheet.getRange(2, 1, lastRow - 1, 1).setNumberFormat('@STRING@');
  for (var c = 1; c <= Math.min(6, numCols); c++) {
    try { sheet.autoResizeColumn(c); } catch(e) {}
  }
  try {
    sheet.getRange(1, 1, Math.max(sheet.getLastRow(), 1), numCols).createFilter();
  } catch(e) {}
}

// CONTINUATION TOKEN - KEY FIX: only store position, not row data
function saveContinuation(props, state) {
  const slim = {
    mode          : state.mode,
    projects      : state.projects.map(function(p) { return { gid: p.gid, name: p.name }; }),
    projectIdx    : state.projectIdx,
    taskOffset    : state.taskOffset,
    customHeaders : state.customHeaders,
    filterKeywords: state.filterKeywords || [],
  };
  props.setProperty('SYNC_CONTINUATION', JSON.stringify(slim));
}

function loadContinuation(props, mode) {
  const raw = props.getProperty('SYNC_CONTINUATION');
  if (!raw) return null;
  try {
    const state = JSON.parse(raw);
    if (state.mode !== mode) return null;
    return state;
  } catch(e) { return null; }
}

function clearContinuation() {
  PropertiesService.getScriptProperties().deleteProperty('SYNC_CONTINUATION');
  try { SpreadsheetApp.getUi().alert('Continuation state cleared.'); } catch(e) {}
}

// DATE RANGE HELPERS
function getDDateRange(mode) {
  const now   = new Date();
  const year  = now.getFullYear();
  const month = now.getMonth();
  switch (mode) {
    case 'MTD': return { from: new Date(year, month, 1, 0, 0, 0), to: now };
    case 'QTD': return { from: new Date(year, Math.floor(month / 3) * 3, 1, 0, 0, 0), to: now };
    default:    return { from: new Date('2020-01-01'), to: now };
  }
}

function fmtD(date) {
  try { return Utilities.formatDate(date, Session.getScriptTimeZone(), 'yyyy-MM-dd'); }
  catch(e) { return ''; }
}

function fmtDate(isoStr) {
  if (!isoStr) return '';
  try { return Utilities.formatDate(new Date(isoStr), Session.getScriptTimeZone(), 'M/d/yyyy h:mm a'); }
  catch(e) { return isoStr; }
}

// ASANA API WRAPPER
function asanaGet(url) {
  const options = {
    method: 'get',
    headers: { 'Authorization': 'Bearer ' + getPAT() },
    muteHttpExceptions: true,
  };
  var attempts = 0;
  while (attempts < CFG.RETRY_LIMIT) {
    attempts++;
    const resp = UrlFetchApp.fetch(url, options);
    const code = resp.getResponseCode();
    if (code === 200) return JSON.parse(resp.getContentText());
    if (code === 429) {
      const retryAfter = parseInt(resp.getHeaders()['Retry-After'] || '0');
      Utilities.sleep((retryAfter * 1000) + (1000 * attempts));
      continue;
    }
    if (code >= 500) { Utilities.sleep(2000 * attempts); continue; }
    throw new Error('Asana API ' + code + ': ' + resp.getContentText().substring(0, 300));
  }
  throw new Error('Max retries exceeded on Asana API request');
}

// SYNC LOG
function log(ss, msg) {
  console.log(msg);
  if (!ss) return;
  try {
    var logSheet = ss.getSheetByName(CFG.SHEETS.LOG);
    if (!logSheet) {
      logSheet = ss.insertSheet(CFG.SHEETS.LOG);
      logSheet.getRange(1, 1, 1, 2).setValues([['Timestamp', 'Message']]);
      logSheet.getRange(1, 1, 1, 2).setBackground('#1a73e8').setFontColor('#fff').setFontWeight('bold');
    }
    logSheet.appendRow([new Date(), msg]);
    const lastRow = logSheet.getLastRow();
    if (lastRow > 1001) logSheet.deleteRows(2, lastRow - 1001);
  } catch(e) {}
}

// TRIGGERS
function setupTwiceDailyTriggers() {
  removeTriggers();
  ScriptApp.newTrigger('syncMTD').timeBased().everyDays(1).atHour(6).create();
  ScriptApp.newTrigger('syncMTD').timeBased().everyDays(1).atHour(18).create();
  try { SpreadsheetApp.getUi().alert('Twice-daily MTD sync scheduled: 6:00 AM and 6:00 PM'); } catch(e) {}
}

function removeTriggers() {
  ScriptApp.getProjectTriggers().forEach(function(t) { ScriptApp.deleteTrigger(t); });
  try { SpreadsheetApp.getUi().alert('All triggers removed.'); } catch(e) {}
}