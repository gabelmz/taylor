// PAT MANAGEMENT
function getPAT() {
  const pat = PropertiesService.getScriptProperties().getProperty('ASANA_PAT');
  if (!pat) throw new Error('Asana PAT not set. Use menu: Set Asana PAT');
  return pat;
}

function setupPAT() {
  PropertiesService.getScriptProperties().setProperty('ASANA_PAT', 'PASTE_YOUR_PAT_HERE');
  Logger.log('PAT saved to Script Properties.');
}

function promptSetPAT() {
  const ui  = SpreadsheetApp.getUi();
  const res = ui.prompt('Set Asana PAT', 'Paste your Asana Personal Access Token:', ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() === ui.Button.OK) {
    const pat = res.getResponseText().trim();
    if (pat.length > 10) {
      PropertiesService.getScriptProperties().setProperty('ASANA_PAT', pat);
      ui.alert('PAT saved securely in Script Properties.');
    } else {
      ui.alert('PAT looks too short - not saved.');
    }
  }
}

// PROJECT FILTER
function promptProjectFilter() {
  const ui = SpreadsheetApp.getUi();
  let projectNames = '';
  try {
    const projects = getPortfolioProjects();
    projectNames = projects.map(function(p) { return p.name; }).join('\n  - ');
  } catch(e) {
    projectNames = '(could not fetch - check PAT)';
  }
  const res = ui.prompt(
    'Filter Projects',
    'Enter project name keywords to sync (comma-separated).\n' +
    'Leave blank to sync ALL projects.\n\n' +
    'Available projects:\n  - ' + projectNames,
    ui.ButtonSet.OK_CANCEL
  );
  if (res.getSelectedButton() !== ui.Button.OK) return null;
  const input = res.getResponseText().trim();
  if (!input) return [];
  return input.split(',').map(function(s) { return s.trim().toLowerCase(); }).filter(Boolean);
}

function syncWithProjectFilter() {
  const filters = promptProjectFilter();
  if (filters === null) return;
  const props = PropertiesService.getScriptProperties();
  props.setProperty('PROJECT_FILTER', JSON.stringify(filters));
  runSync('MTD');
}

function projectPassesFilter(projectName, filterKeywords) {
  if (!filterKeywords || filterKeywords.length === 0) return true;
  const nameLower = (projectName || '').toLowerCase();
  return filterKeywords.some(function(kw) { return nameLower.indexOf(kw) !== -1; });
}

// PUBLIC ENTRY POINTS
function syncMTD()     { runSync('MTD');      }
function syncQTD()     { runSync('QTD');      }
function syncAllTime() { runSync('ALL_TIME'); }

// CORE ORCHESTRATOR
function runSync(mode) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) {
    log(null, 'Another sync is already running - skipping.');
    return;
  }

  const ss        = SpreadsheetApp.getActiveSpreadsheet();
  const startTime = Date.now();
  const dateRange = getDDateRange(mode);
  const props     = PropertiesService.getScriptProperties();

  let filterKeywords = [];
  try {
    const storedFilter = props.getProperty('PROJECT_FILTER');
    if (storedFilter) filterKeywords = JSON.parse(storedFilter);
  } catch(e) { filterKeywords = []; }

  const filterLabel = filterKeywords.length ? ' | Filter: [' + filterKeywords.join(', ') + ']' : '';
  log(ss, 'Starting ' + mode + ' sync | ' + fmtD(dateRange.from) + ' -> ' + fmtD(dateRange.to) + filterLabel);
  ss.toast('Starting ' + mode + ' sync...', 'Asana Sync', -1);

  try {
    let state = loadContinuation(props, mode);

    if (!state) {
      const allProjects = getPortfolioProjects();
      log(ss, '  Found ' + allProjects.length + ' projects');
      const projects = allProjects.filter(function(p) { return projectPassesFilter(p.name, filterKeywords); });
      if (projects.length !== allProjects.length) {
        log(ss, '  After filter: ' + projects.length + ' projects match [' + filterKeywords.join(', ') + ']');
      }
      state = {
        mode: mode,
        projects: projects,
        projectIdx: 0,
        taskOffset: null,
        customHeaders: [],
        filterKeywords: filterKeywords,
      };
    }

    while (state.projectIdx < state.projects.length) {
      if (Date.now() - startTime > CFG.TIMEOUT_BUFFER) {
        log(ss, 'Timeout approaching - saving continuation at project ' + state.projectIdx);
        saveContinuation(props, state);
        scheduleResumeTrigger();
        ss.toast('Paused - resuming in ~1 min automatically.', 'Asana Sync', 8);
        lock.releaseLock();
        return;
      }

      const proj = state.projects[state.projectIdx];
      ss.toast('Project ' + (state.projectIdx + 1) + '/' + state.projects.length + ': ' + proj.name, 'Fetching...', -1);

      const result = fetchAndWriteProjectPage(proj, state, dateRange, ss, mode);
      state = result.state;

      if (result.done) {
        log(ss, '  Done: ' + proj.name + ' - ' + result.taskCount + ' tasks');
        state.projectIdx++;
        state.taskOffset = null;
      }

      Utilities.sleep(CFG.RATE_LIMIT_MS);
    }

    clearContinuation();
    props.deleteProperty('PROJECT_FILTER');

    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
    log(ss, 'Done - sync complete in ' + elapsed + 's');
    ss.toast('Sync complete in ' + elapsed + 's', 'Asana Sync', 8);

  } catch (e) {
    log(ss, 'ERROR: ' + e.message + '\n' + e.stack);
    ss.toast('Error: ' + e.message, 'Sync Failed', 10);
    throw e;
  } finally {
    lock.releaseLock();
  }
}

// SCHEDULE RESUME TRIGGER
function scheduleResumeTrigger() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(function(t) {
    if (t.getHandlerFunction() === 'resumeSync') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('resumeSync').timeBased().after(60 * 1000).create();
}

function resumeSync() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(function(t) {
    if (t.getHandlerFunction() === 'resumeSync') ScriptApp.deleteTrigger(t);
  });
  const props = PropertiesService.getScriptProperties();
  const raw   = props.getProperty('SYNC_CONTINUATION');
  if (!raw) { Logger.log('resumeSync: no continuation found'); return; }
  try {
    const state = JSON.parse(raw);
    runSync(state.mode || 'MTD');
  } catch(e) {
    Logger.log('resumeSync error: ' + e.message);
  }
}

// FETCH ONE PAGE + WRITE IMMEDIATELY
function fetchAndWriteProjectPage(proj, state, dateRange, ss, mode) {
  let url = 'https://app.asana.com/api/1.0/tasks' +
            '?project=' + proj.gid +
            '&opt_fields=' + encodeURIComponent(TASK_OPT_FIELDS) +
            '&limit=' + CFG.BATCH_SIZE;

  if (state.taskOffset) url += '&offset=' + state.taskOffset;
  if (state.mode !== 'ALL_TIME') url += '&modified_since=' + dateRange.from.toISOString();

  const resp = asanaGet(url);
  if (!resp || !resp.data) return { state: state, done: true, taskCount: 0 };

  const taskRows    = [];
  const commentRows = [];
  const attachRows  = [];
  const subtaskRows = [];
  const newCFHeaders = state.customHeaders.slice();

  resp.data.forEach(function(task) {
    (task.custom_fields || []).forEach(function(cf) {
      const name = (cf.name || '').trim();
      if (name && newCFHeaders.indexOf(name) === -1) newCFHeaders.push(name);
    });

    taskRows.push(buildTaskRow(task, proj.name, state.mode));

    fetchStories(task.gid).forEach(function(s) {
      commentRows.push(buildCommentRow(s, task, proj.name));
    });

    fetchAttachments(task.gid).forEach(function(a) {
      attachRows.push(buildAttachmentRow(a, task, proj.name));
    });

    if (task.num_subtasks > 0) {
      fetchSubtasks(task.gid).forEach(function(st) {
        subtaskRows.push(buildSubtaskRow(st, task, proj.name));
      });
    }
  });

  state.customHeaders = newCFHeaders;
  const nextOffset = resp.next_page ? resp.next_page.offset : null;
  state.taskOffset = nextOffset;

  const taskHeaders = TASK_STATIC_HEADERS.slice();
  newCFHeaders.forEach(function(cfName) {
    taskHeaders.splice(taskHeaders.length - 2, 0, cfName);
  });

  const taskArrays = taskRows.map(function(row) {
    const staticPart = [
      row.gid, row.name, row.project, row.section, row.permalink,
      row.assignee, row.assigneeEmail, row.followers,
      row.createdAt, row.completedAt, row.modifiedAt,
      row.dueOn, row.startOn, row.isComplete,
      row.parentGid, row.parentName, row.numSubtasks,
      row.deps, row.dens, row.tags, row.notes,
    ];
    const cfPart = newCFHeaders.map(function(cfName) { return row.customFields[cfName] || ''; });
    return staticPart.concat(cfPart).concat([row.syncMode, row.syncedAt]);
  });

  appendToSheet(ss, CFG.SHEETS.TASKS,       taskHeaders,        taskArrays,   mode, 'Task GID');
  appendToSheet(ss, CFG.SHEETS.COMMENTS,    COMMENT_HEADERS,    commentRows,  mode, 'Story GID');
  appendToSheet(ss, CFG.SHEETS.ATTACHMENTS, ATTACHMENT_HEADERS, attachRows,   mode, 'Attachment GID');
  appendToSheet(ss, CFG.SHEETS.SUBTASKS,    SUBTASK_HEADERS,    subtaskRows,  mode, 'Subtask GID');

  return { state: state, done: !nextOffset, taskCount: resp.data.length };
}

// APPEND / UPSERT TO A SHEET
function appendToSheet(ss, sheetName, headers, rows, mode, idHeader) {
  if (rows.length === 0) return;
  let sheet = ss.getSheetByName(sheetName);

  if (mode === 'ALL_TIME') {
    if (!sheet) {
      sheet = ss.insertSheet(sheetName);
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    } else {
      const existingHeaders = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1)).getValues()[0];
      headers.forEach(function(h, i) {
        if (existingHeaders.indexOf(h) === -1) sheet.getRange(1, i + 1).setValue(h);
      });
    }
    const lastRow = Math.max(sheet.getLastRow(), 1);
    sheet.getRange(lastRow + 1, 1, rows.length, headers.length).setValues(rows);
  } else {
    if (!sheet) {
      sheet = ss.insertSheet(sheetName);
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
      styleSheet(sheet, headers.length);
      return;
    }
    const existingHeaders = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1)).getValues()[0];
    headers.forEach(function(h, i) {
      if (existingHeaders.indexOf(h) === -1) sheet.getRange(1, i + 1).setValue(h);
    });
    const existingData = sheet.getDataRange().getValues();
    const idColIdx = 0;
    const existingIds = new Set(existingData.slice(1).map(function(r) { return String(r[idColIdx]); }));
    const toUpdate = rows.filter(function(r) { return existingIds.has(String(r[idColIdx])); });
    const toAppend = rows.filter(function(r) { return !existingIds.has(String(r[idColIdx])); });

    toUpdate.forEach(function(newRow) {
      const rowIdx = existingData.findIndex(function(r, i) {
        return i > 0 && String(r[idColIdx]) === String(newRow[idColIdx]);
      });
      if (rowIdx > 0) {
        const numCols = Math.min(newRow.length, headers.length);
        sheet.getRange(rowIdx + 1, 1, 1, numCols).setValues([newRow.slice(0, numCols)]);
      }
    });

    if (toAppend.length > 0) {
      const lastRow = sheet.getLastRow();
      sheet.getRange(lastRow + 1, 1, toAppend.length, headers.length).setValues(toAppend);
    }
  }
  styleSheet(sheet, headers.length);
}

// ROW BUILDERS
function buildTaskRow(task, projectName, mode) {
  const memberships = task.memberships || [];
  const section = memberships.map(function(m) { return m.section ? m.section.name : ''; }).filter(Boolean).join(', ');
  const followers = (task.followers || []).map(function(f) { return f.name || f.email || ''; }).join(', ');
  const deps = (task.dependencies || []).map(function(d) { return d.gid; }).join(', ');
  const dens = (task.dependents   || []).map(function(d) { return d.gid; }).join(', ');
  return {
    gid          : task.gid || '',
    name         : task.name || '',
    project      : projectName || '',
    section      : section,
    permalink    : task.permalink_url || '',
    assignee     : task.assignee ? task.assignee.name : '',
    assigneeEmail: task.assignee ? (task.assignee.email || '') : '',
    followers    : followers,
    createdAt    : fmtDate(task.created_at),
    completedAt  : fmtDate(task.completed_at),
    modifiedAt   : fmtDate(task.modified_at),
    dueOn        : task.due_on || '',
    startOn      : task.start_on || '',
    isComplete   : task.completed ? 'Yes' : 'No',
    parentGid    : task.parent ? task.parent.gid : '',
    parentName   : task.parent ? task.parent.name : '',
    numSubtasks  : task.num_subtasks || 0,
    deps         : deps,
    dens         : dens,
    tags         : (task.tags || []).map(function(t) { return t.name; }).join(', '),
    notes        : task.notes || '',
    syncMode     : mode,
    syncedAt     : new Date().toISOString(),
    customFields : (task.custom_fields || []).reduce(function(acc, cf) {
      const name = (cf.name || '').trim();
      if (!name) return acc;
      acc[name] = cf.display_value
        || (cf.enum_value ? cf.enum_value.name : null)
        || (cf.multi_enum_values ? cf.multi_enum_values.map(function(v) { return v.name; }).join(', ') : null)
        || cf.text_value
        || (cf.number_value != null ? String(cf.number_value) : null)
        || (cf.date_value ? cf.date_value.date : null)
        || '';
      return acc;
    }, {}),
  };
}

function buildCommentRow(story, task, projectName) {
  return [
    story.gid || '',
    task.gid || '',
    task.name || '',
    projectName || '',
    story.created_by ? story.created_by.name : '',
    story.created_by ? (story.created_by.email || '') : '',
    story.type === 'comment' ? 'comment' : 'system',
    story.text || '',
    fmtDate(story.created_at) || '',
    story.is_pinned ? 'Yes' : 'No',
    new Date().toISOString(),
  ];
}

function buildAttachmentRow(att, task, projectName) {
  return [
    att.gid || '',
    task.gid || '',
    task.name || '',
    projectName || '',
    att.name || '',
    att.download_url || att.permanent_url || '',
    att.host || '',
    att.view_url || '',
    fmtDate(att.created_at) || '',
    new Date().toISOString(),
  ];
}

function buildSubtaskRow(st, parentTask, projectName) {
  return [
    st.gid || '',
    st.name || '',
    parentTask.gid || '',
    parentTask.name || '',
    projectName || '',
    st.assignee ? st.assignee.name : '',
    st.assignee ? (st.assignee.email || '') : '',
    fmtDate(st.created_at) || '',
    fmtDate(st.completed_at) || '',
    st.due_on || '',
    st.completed ? 'Yes' : 'No',
    st.permalink_url || '',
    new Date().toISOString(),
  ];
}

